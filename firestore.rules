rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrateur d'EPS ONE
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'steffdelaseuva@gmail.com';
    }
    function accessDoc() {
      return get(/databases/$(database)/documents/access/$(request.auth.uid)).data;
    }
    // Compte autorisé ET synchronisation activée par l'administrateur
    function canSync() {
      return isAdmin() || (exists(/databases/$(database)/documents/access/$(request.auth.uid))
        && accessDoc().status == 'approved' && accessDoc().get('sync', false) == true);
    }

    // Demandes d'accès : chacun crée la sienne (en attente), seul l'administrateur décide
    match /access/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'status', 'date'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }

    // Données chiffrées : uniquement le propriétaire, autorisé avec synchronisation activée
    match /epsone/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && canSync();
    }
  }
}
